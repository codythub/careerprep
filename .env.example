# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` for local development. NEVER commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.
#
# This frontend has NO database and holds NO secrets. Everything below is public:
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so a
# change needs a new deploy. Secrets (Paystack keys, DB, storage) live in Laravel.
# ─────────────────────────────────────────────────────────────────────────────

# Required. Base URL of the Laravel CareerPrep API; "/api/v1" is appended if missing.
# Local Laravel default: http://localhost:8000
# Laravel's FRONTEND_URL (CORS) must equal this site's origin.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Recommended in production. Public base URL of this site (canonical URLs, sitemap, Open Graph).
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Set "true" on temporary/preview deployments to keep the site out of search engines.
SITE_NOINDEX=""
