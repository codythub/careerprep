# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` for local development. NEVER commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, sitemap, emails, Paystack callback).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set "true" on temporary/preview deployments to keep the site out of search engines.
SITE_NOINDEX=""

# ── CareerPrep Laravel API (authoritative backend for candidates) ──────────
# Base URL of the Laravel backend. "/api/v1" is appended automatically if missing.
# Local Laravel default: http://localhost:8000
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Supabase: use the pooled "Transaction" connection string (port 6543) with
# ?pgbouncer=true&connection_limit=1 for DATABASE_URL, and the direct connection
# (port 5432) for DIRECT_URL (used by migrations).
# Local (npm run db:local): postgresql://postgres:postgres@localhost:54329/careerprep
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/careerprep"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/careerprep"

# ── Authentication (Auth.js) ─────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Optional on Vercel (auto-detected). Set to your production URL elsewhere.
AUTH_URL="http://localhost:3000"

# ── Paystack ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use test keys (sk_test_/pk_test_) until launch.
# The secret key is also used to verify webhook signatures (Paystack has no separate webhook secret).
# Webhook URL to configure in Paystack: https://<your-domain>/api/paystack/webhook
PAYSTACK_SECRET_KEY=""
# Public key is not currently required (hosted checkout is used) but kept for future inline checkout.
PAYSTACK_PUBLIC_KEY=""

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Create two buckets: "resumes" (PRIVATE) and "media" (PUBLIC).
# The service-role key is server-only and bypasses RLS — never expose it.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRIVATE_BUCKET="resumes"
SUPABASE_PUBLIC_BUCKET="media"
# "supabase" | "local". Defaults to supabase when SUPABASE_URL + service key are set, else local.
# The local filesystem driver is refused in production.
STORAGE_DRIVER=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are printed to the server console (development).
RESEND_API_KEY=""
# Must be a verified sender domain in Resend, e.g. "CareerPrep NG <hello@yourdomain.com>"
EMAIL_FROM=""
# Receives operational alerts (payment verification failures, heavily reported jobs).
ADMIN_ALERT_EMAIL=""

# ── Cron ─────────────────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/daily.
CRON_SECRET=""

# ── Seed (npm run db:seed) ───────────────────────────────────────────────────
# Admin account created by the seed. Password must be ≥ 12 characters.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Platform Admin"
# Demo jobs are seeded in development only. Set "true" to force in production (not recommended).
SEED_DEMO_JOBS=""
